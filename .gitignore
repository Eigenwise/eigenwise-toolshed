# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# Claude Code local settings + tool artifacts (never commit to this public repo)
# — everything under .claude/ is ignored EXCEPT shared project settings and
# team live rules. settings.local.json (per-machine overrides) stays ignored.
.claude/*
!.claude/settings.json
!.claude/live-rules/
!.claude/live-rules/**
.playwright-mcp/

# Node (only relevant if a plugin ever adds tooling)
node_modules/
npm-debug.log*
yarn-error.log*

# Logs
*.log
.sq-shots/

# Playwright MCP session artifacts and ad-hoc verification captures
.playwright-mcp/
/*.png
