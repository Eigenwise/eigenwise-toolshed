      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        },
        "cursor": {
          "type": "string",
          "description": "Opaque."
        },
        "limit": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16384,
          "description": "UTF-8 bytes."
        },
