      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "entry": {
          "type": "string",
          "pattern": "^(DECISION|CONSTRAINT|DISCOVERY)\\s*:",
          "description": "Must begin DECISION:, CONSTRAINT:, or DISCOVERY:; max 16,000 UTF-8 bytes."
