  {
    "name": "add",
    "description": "File a ticket. review-audit binds reviewTarget to one terminal candidate.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ]
        },
        "highStakes": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractWaiver": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "anchors": {
          "type": "string",
          "maxLength": 4000
        },
        "verify": {
          "type": "string",
          "maxLength": 1000,
          "description": "verifyKind attestation: `attestation: <attestationArtifact verbatim> | <evidence produced> | <what it showed>`."
        },
        "verifyKind": {
          "type": "string",
          "enum": [
            "command",
            "attestation"
          ]
        },
        "attestationArtifact": {
          "type": "string",
          "maxLength": 1000
        },
        "storyId": {
          "type": "string",
          "pattern": "^US-\\d+$"
        },
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Legacy score; why required."
        },
        "why": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "reviewTarget": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "sourceRevision": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "ref"
          ]
        },
        "route": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ]
        },
        "unclassified": {
          "type": "boolean"
        }
      },
      "required": [
        "title"
      ]
    }
  },
