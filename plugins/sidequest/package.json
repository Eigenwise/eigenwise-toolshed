{
  "name": "@eigenwise/sidequest",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build-check.mjs",
    "drift": "npm run build && node scripts/drift.mjs",
    "test:files": "npm run typecheck && node --import tsx --import ./test/_sidequest-test-home.ts --test",
    "test:full": "npm run typecheck && npm run build:check && node scripts/test-full.mjs",
    "test:perf": "node --import tsx --test test/*.perf.test.ts",
    "quality:crap": "node ../../scripts/quality/crap.mjs",
    "coverage:lcov": "node scripts/build.mjs --sourcemap=external && node --import tsx --import ./test/_sidequest-test-home.ts --test --test-concurrency=2 --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=hooks/** --test-coverage-include=bin/** --test-reporter=lcov"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
