{
  "description": "codebase-mapper atomically emits one independent <=192 B Stop veto per update responsibility across overlapping hook processes; generation-bound stale-lock cleanup cannot delete a live replacement, Claude batches concurrent blocking hooks into one continuation, stable documented Stop fields identify prompt-less batches even while transcripts advance, resolved responsibilities can warn again, and stop_hook_active re-entry stays silent",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:sidequest-exec.*|general-purpose|codebase-mapper:.*writer.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
