          },
          "expr": "sum by (workbench_attribute_tool_name) (sum_over_time({service_name=\"workbench-observer\"} |= \"workbench.recharge_rollup\" | workbench_attribute_tool_name != \"all\" | unwrap workbench_measurement_tool_result_bytes_value [$bucket]))",
          "legendFormat": "{{workbench_attribute_tool_name}}"
        }
      ],
      "interval": "$bucket"
