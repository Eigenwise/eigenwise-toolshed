{
  "uid": "claude-code-usage",
  "title": "Claude Code Usage",
  "tags": [
    "claude-code",
    "workbench",
    "cost",
    "reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_token_usage_tokens_total, project_id)",
          "refId": "project"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h,1d",
        "auto": true,
        "auto_count": 120,
        "auto_min": "1m",
        "current": {
          "text": "Auto",
          "value": "$__auto"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 200,
      "title": "At a glance",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "title": "Total spend",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "__GATEWAY_TOTAL_COST_TARGET__",
          "legendFormat": "Total spend"
        }
      ],
      "interval": "$bucket",
      "description": "List-price-equivalent cost across every backend in the selected range. Subscription billing can differ."
    },
    {
      "id": 33,
      "title": "Work routed to Codex",
      "description": "Share of total list-price-equivalent spend routed to Codex in the selected range.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "vertical",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "No gateway usage in this range"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "__CODEX_COST_SHARE_TARGET__",
          "legendFormat": "Work routed to Codex",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Tool failure rate",
      "description": "Share of observed tool calls marked failed or error in the selected range.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "expr": "(100 * sum(count_over_time({service_name=\"workbench-observer\"} |= \"hook.post_tool_use\" | workbench_attribute_status =~ \"error|failed\" [$__range])) / sum(count_over_time({service_name=\"workbench-observer\"} |= \"hook.post_tool_use\" [$__range]))) or vector(0)"
        }
      ]
    },
    {
      "id": 201,
      "title": "Where the spend goes",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 32,
      "title": "Cost by model",
      "description": "List-price-equivalent cost trend by resolved backend model. Model aliases are normalized before pricing.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "interval": "$bucket",
      "maxDataPoints": 120,
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{workbench_attribute_model}}",
          "expr": "__GATEWAY_MODEL_PRICE_TARGETS__"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cost by project",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{workbench_attribute_project_name}}",
          "expr": "__GATEWAY_PROJECT_PRICE_TARGETS__"
        }
      ],
      "interval": "$bucket",
      "maxDataPoints": 120,
      "description": "List-price-equivalent cost trend across every backend. Usage without a currently active project is grouped as Other / unattributed."
    },
    {
      "id": 20,
      "title": "Context by orchestrator vs executor",
      "description": "Context-token volume by agent role. This shows which role is consuming the model context budget.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (workbench_attribute_agent_role) (sum_over_time({service_name=\"workbench-observer\"} |= \"gateway.token.usage\" | workbench_session_id !~ \"(probe|session-gateway).*\" | unwrap workbench_measurement_context_tokens_value [$bucket]))",
          "legendFormat": "{{workbench_attribute_agent_role}}"
        }
      ],
      "maxDataPoints": 120,
      "interval": "$bucket"
    },
    {
      "id": 202,
      "title": "Failures and source activity",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "title": "Hook failures over time",
      "description": "Observed failed hook completions. A flat zero means no matching failures in the selected range.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 35
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (workbench_attribute_hook_name) (count_over_time({service_name=\"workbench-observer\"} |= \"claude_code.hook_execution_complete\" | workbench_session_id !~ \"(probe|session-gateway).*\" | workbench_attribute_status =~ \"error|failed\" [$bucket])) or vector(0)",
          "legendFormat": "{{workbench_attribute_hook_name}}"
        }
      ],
      "interval": "$bucket"
    },
    {
      "id": 210,
      "title": "Gateway errors and throttles",
      "description": "Gateway log records containing an error, failure, throttle, rate-limit, or HTTP 429 signal.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "No gateway error records in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"codex-gateway\"} |~ \"(?i)(error|fail|throttl|rate.?limit|429)\" [$bucket])) or vector(0)",
          "legendFormat": "errors / throttles"
        }
      ],
      "interval": "$bucket"
    },
    {
      "id": 220,
      "title": "Claude metric samples, 5m",
      "description": "Recent Prometheus samples. Zero means Claude metrics have not arrived in five minutes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples in the last 5 minutes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count_over_time(claude_code_token_usage_tokens_total{project_id=~\"$project\"}[5m]))",
          "legendFormat": "Claude metric samples, 5m",
          "instant": true
        }
      ]
    },
    {
      "id": 221,
      "title": "Observer records, 5m",
      "description": "Recent observer log records. Zero means the observer has not reported in five minutes.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
