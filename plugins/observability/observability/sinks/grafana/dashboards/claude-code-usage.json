              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"workbench-observer\"}[5m]))",
          "legendFormat": "Observer records, 5m",
          "instant": true
        }
      ]
    },
    {
      "id": 222,
      "title": "Gateway records, 5m",
