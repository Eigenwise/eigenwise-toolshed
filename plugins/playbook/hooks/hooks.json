{
  "description": "playbook: count finished sessions and suggest a transcript retro once enough have gone by. Inert unless PLAYBOOK_NUDGE is set.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/session-nudge.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/session-nudge.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
